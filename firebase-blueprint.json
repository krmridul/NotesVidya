{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Customer profile document stored in Firestore indexed by Firebase Auth UID",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of customer",
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "description": "Customer unique identifier matching UID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Full name of the customer",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the customer",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number of the customer",
          "maxLength": 30
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether customer email was verified via OTP"
        },
        "role": {
          "type": "string",
          "enum": ["customer", "admin"],
          "description": "Role of the user in the system"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"],
          "description": "Account status"
        },
        "ordersCount": {
          "type": "number",
          "description": "Number of orders placed"
        },
        "totalSpent": {
          "type": "number",
          "description": "Total amount spent in INR"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last account update"
        }
      },
      "required": ["uid", "name", "email", "role", "status"]
    },
    "User": {
      "title": "User",
      "description": "User profile and account information stored in Firestore",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User unique identifier matching Firebase Auth UID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Full name of the user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number of the user",
          "maxLength": 30
        },
        "role": {
          "type": "string",
          "enum": ["customer", "admin"],
          "description": "Role of the user in the system"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"],
          "description": "Account status"
        },
        "ordersCount": {
          "type": "number",
          "description": "Number of orders placed"
        },
        "totalSpent": {
          "type": "number",
          "description": "Total amount spent in INR"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        }
      },
      "required": ["id", "name", "email", "role", "status"]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer profile collection indexed by Firebase Auth UID"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection indexed by Firebase Auth UID"
    }
  }
}
