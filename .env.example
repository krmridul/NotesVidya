# Firebase Client Configuration (Vite Web SDK)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Database Connection (Optional: PostgreSQL connection string. Defaults to durable local persistent storage if not provided)
DATABASE_URL=""

# Razorpay Payment Gateway (Real Production Credentials)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# JWT Secret for Session & Download Token Signing
JWT_SECRET="production-jwt-signature-secret-key-change-in-prod"

# Brevo Transactional Email API (Required for Customer Email OTP Verification)
BREVO_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="NotesVidya"

# Secondary Email Fallback (SMTP - Only used if Brevo is not configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
